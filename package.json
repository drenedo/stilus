{
    "name": "stilus",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Stilus workspace tooling: Prettier and ESLint for frontend and server.",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "format": "prettier --write .",
