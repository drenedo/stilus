# Telegram profile only. Fill these values in .env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STILUS_USER=
STILUS_PASSWORD=

# Web profile: 127.0.0.1 keeps the UI local. Use 0.0.0.0 for LAN access
STILUS_BIND_ADDRESS=127.0.0.1
STILUS_WEB_PORT=8000

# Leave empty to use the named volume "stilus-data".
STILUS_DATA_PATH=

# UID/GID used by the container.
# The /data directory (or bind mount) must be writable by this user.
PUID=10001
PGID=10001

# Set to true only when the web UI is served over HTTPS.
COOKIE_SECURE=false
